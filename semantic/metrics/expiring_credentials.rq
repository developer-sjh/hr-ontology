# metric: expiring_credentials
# term: Expiring credential
# params: asOf known withinDays
# description: Credentials valid on the day whose last valid day falls within the next N days and that have not been renewed.
SELECT ?personId ?certification ?expires WHERE {
  ?cred a hr:Credential ; hr:heldBy ?person ; hr:ofCertification ?cert .
#include ValidRecord rec=?cred asOf=?asOf known=?known
  ?cred hr:validTo ?expires .
  FILTER(?expires <= ?horizon)
  FILTER NOT EXISTS { ?next hr:follows ?cred }
  ?person hr:personId ?personId .
  ?cert rdfs:label ?certification .
}
ORDER BY ?expires ?personId
